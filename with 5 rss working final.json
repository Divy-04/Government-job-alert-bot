    {
      "parameters": {
        "jsCode": "// Get all links already saved in Google Sheet\nconst seenLinks = $('Get row(s) in sheet').all()\n  .map(item => item.json.Link)\n  .filter(link => link);\n\n// Get all jobs from Code node (parsed RSS)\nconst allJobs = $('Code in JavaScript').all();\n\n// Only keep jobs NOT already in sheet\nconst newJobs = allJobs.filter(job => {\n  return !seenLinks.includes(job.json.link);\n});\n\nreturn newJobs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
