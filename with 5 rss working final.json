    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer api key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a strict job filter for B.Tech/BE/Diploma Computer Science and IT students. Reply ONLY in valid JSON, no extra text: {\\\"relevant\\\": true, \\\"reason\\\": \\\"one line\\\", \\\"category\\\": \\\"Software/IT/Electronics/Other\\\"}. Mark relevant=true ONLY if the job qualification accepts any of these: B.Tech CS, BE CS, B.Tech IT, BE IT, B.Tech Software Engineering, Diploma in CS, Diploma in IT, BCA, MCA, B.Sc CS, Computer Science degree, Information Technology degree, Software Engineering degree. Mark relevant=false if job is for: civil, mechanical, electrical, arts, commerce, nursing, pharmacy, law, agriculture, or any non-CS field. If qualification is general (\\\"any graduate\\\", \\\"any degree\\\") mark relevant=false. Job Title: {{ $json.title }} Qualification: {{ $json.description.replace(/[\\\"\\\\n\\\\r]/g, ' ').substring(0, 300) }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        32,
        -48
      ],
      "id": "819f22e8-7fe1-408f-b7d2-a89258c7d009",
