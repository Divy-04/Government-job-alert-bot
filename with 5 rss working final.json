    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const input of $input.all()) {\n  const raw = input.json.data;\n  \n  const jobMatches = raw.match(/<item>([\\s\\S]*?)<\\/item>/g) || [];\n  \n  for (const job of jobMatches) {\n    const title = (job.match(/<title><!\\[CDATA\\[(.*?)\\]\\]><\\/title>/) || \n                   job.match(/<title>(.*?)<\\/title>/))?.[1] || '';\n    const link = (job.match(/<link>(.*?)<\\/link>/) || \n                  job.match(/<guid[^>]*>(.*?)<\\/guid>/))?.[1] || '';\n    const description = (job.match(/<description><!\\[CDATA\\[(.*?)\\]\\]><\\/description>/) || \n                         job.match(/<description>(.*?)<\\/description>/))?.[1] || '';\n    const pubDate = job.match(/<pubDate>(.*?)<\\/pubDate>/)?.[1] || '';\n\n    if (title && link) {\n      items.push({\n        json: { title, link, description, pubDate }\n      });\n    }\n  }\n}\n\nreturn items;"
      },
