      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nconst groqItems = $input.all();\nconst jobItems = $('Code in JavaScript1').all();\n\nfor (let i = 0; i < groqItems.length; i++) {\n  try {\n    const content = groqItems[i].json.choices[0].message.content;\n    const cleaned = content.replace(/```json|```/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    const job = jobItems[i]?.json || {};\n\n    items.push({\n      json: {\n        relevant: parsed.relevant,\n        reason: parsed.reason,\n        category: parsed.category,\n        title: job.title,\n        link: job.link,\n        description: job.description,\n        pubDate: job.pubDate,\n      }\n    });\n  } catch(e) {\n    items.push({\n      json: {\n        relevant: false,\n        reason: \"parse error\",\n        category: \"Other\"\n      }\n    });\n  }\n}\n\nreturn items;"
      },
